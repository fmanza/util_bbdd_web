{
  "components": {
    "schemas": {
      "HealthStatus": {
        "description": "Estado del servicio.\n\nAttributes:\n    status: ``ok`` si ``config.db`` responde y util_bbdd está instalado; ``degraded`` si no.\n    version: Versión de util_bbdd_web.\n    util_bbdd_version: Versión instalada de util_bbdd.\n    database: Estado de ``config.db``.",
        "properties": {
          "database": {
            "enum": [
              "ok",
              "error"
            ],
            "title": "Database",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          },
          "util_bbdd_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Util Bbdd Version"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version",
          "util_bbdd_version",
          "database"
        ],
        "title": "HealthStatus",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "util_bbdd_web",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/health": {
      "get": {
        "description": "Devuelve el estado de ``config.db`` y las versiones de la aplicación y de util_bbdd.",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Estado del servicio",
        "tags": [
          "health"
        ]
      }
    }
  }
}
