# Variables de Docker Compose para util_bbdd_web. Copia a `.env` (no se versiona) y ajusta.
# Los secretos NO van aquí: están en secrets/*.txt (scripts/generate_secrets.py). Guía: docs/guides/puesta_en_marcha.md

# Nombre de la imagen construida (util_bbdd_web:<UBW_TAG>); en producción, la versión desplegada.
UBW_TAG=1.10.0

# Puerto del equipo en el que se publica la aplicación (siempre en 127.0.0.1; el acceso externo va por el proxy TLS).
UBW_PORT=8080

# Nivel de log de web y worker.
UBW_LOG_LEVEL=INFO

# IP del proxy inverso en la que confía uvicorn para X-Forwarded-For/Proto. Con el proxy en el mismo equipo, la
# pasarela de la red de Docker: docker network inspect util_bbdd_web_default --format '{{(index .IPAM.Config 0).Gateway}}'
UBW_FORWARDED_ALLOW_IPS=127.0.0.1

# Rate limiting por IP (por defecto en la aplicación: 300, 30 y 10).
UBW_RATE_LIMIT_ANONYMOUS_PER_MINUTE=300
UBW_RATE_LIMIT_LOGIN_PER_MINUTE=30
UBW_RATE_LIMIT_LOGIN_FAILURES=10

# Variantes de imagen (al construir): JRE + jaydebeapi para HSQLDB; msodbcsql18 + pyodbc para SQL Server por ODBC.
WITH_HSQLDB=false
WITH_ODBC=false
# libaio1 para Oracle en modo thick (docs/guides/deployment.md#oracle-en-modo-thick-instant-client).
WITH_ORACLE_THICK=false

# Oracle thick: carpeta del Instant Client dentro de UBW_FILES_DIR (p. ej. instantclient_19_32); vacía = sin thick.
UBW_ORACLE_CLIENT_DIR=
